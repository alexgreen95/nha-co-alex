-- ONE-TIME OPERATOR CREDENTIAL OPERATION, NOT A MIGRATION. DO NOT RUN YET.
-- Separate approval is required for interactive psql 17.x over the trusted DIRECT
-- admin route: postgres identity, verified TLS/hostname/CA, gssencmode=disable.
-- Never SQL Editor, Session/Transaction Pooler, API key or sender provisioning.
-- SQL cannot prove the client's host/sslmode/CA selection; those are mandatory
-- operator preconditions. Exclude concurrent privileged role/security changes
-- through COMMIT. The ONLY persistent mutation is \password nca_push_api.
-- No password argument, variable or stored verifier is read. Enter twice hidden.
-- SUCCESS marker consumes this operation permanently: record it; DO NOT RERUN.
\set ON_ERROR_STOP on
\set ECHO none
\set ECHO_HIDDEN off
\set HISTFILE /dev/null
BEGIN;
SET LOCAL search_path='';
SET LOCAL statement_timeout='15s';
SET LOCAL lock_timeout='2s';
SET LOCAL idle_in_transaction_session_timeout='2min';
SET LOCAL transaction_timeout='5min';
SET LOCAL password_encryption='scram-sha-256';
DO $guard$
DECLARE target pg_catalog.pg_roles%ROWTYPE;
BEGIN
 IF CURRENT_USER<>'postgres' OR SESSION_USER<>'postgres'
 OR pg_catalog.current_database()<>'postgres'
 OR pg_catalog.current_setting('server_version_num')<>'170011'
 OR NOT EXISTS(SELECT 1 FROM pg_catalog.pg_stat_ssl WHERE pid=pg_catalog.pg_backend_pid() AND ssl)
 THEN RAISE EXCEPTION 'NCA_PUSH_API_CREDENTIAL_CONTEXT_OR_TLS'; END IF;
 SELECT * INTO target FROM pg_catalog.pg_roles WHERE rolname='nca_push_api';
 IF NOT FOUND OR NOT target.rolcanlogin OR target.rolinherit OR target.rolsuper
 OR target.rolcreaterole OR target.rolcreatedb OR target.rolreplication OR target.rolbypassrls
 OR target.rolvaliduntil IS NOT NULL OR target.rolconnlimit<>-1
 OR EXISTS(SELECT 1 FROM pg_catalog.pg_db_role_setting WHERE setrole=target.oid)
 OR EXISTS(SELECT 1 FROM pg_catalog.pg_shdepend WHERE refclassid=1260 AND refobjid=target.oid AND deptype='o')
 THEN RAISE EXCEPTION 'NCA_PUSH_API_CREDENTIAL_ROLE_DRIFT'; END IF;
 IF (SELECT pg_catalog.count(*) FROM pg_catalog.pg_auth_members WHERE roleid=target.oid OR member=target.oid OR grantor=target.oid)<>1
 OR NOT EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m JOIN pg_catalog.pg_roles r ON r.oid=m.member
 WHERE m.roleid=target.oid AND r.rolname='postgres' AND m.grantor=10
 AND m.admin_option AND NOT m.inherit_option AND NOT m.set_option)
 THEN RAISE EXCEPTION 'NCA_PUSH_API_CREDENTIAL_MEMBERSHIP_DRIFT'; END IF;
END;
$guard$;
-- Non-secret metadata only. pg_roles masks passwords; exclude the masked field.
-- No pg_authid or stored password verifier is inspected.
SELECT r.oid::pg_catalog.text AS oid,
 pg_catalog.md5(pg_catalog.jsonb_build_object('role',pg_catalog.to_jsonb(r)-'rolpassword',
 'memberships',(SELECT pg_catalog.jsonb_agg(pg_catalog.to_jsonb(m) ORDER BY m.roleid,m.member,m.grantor)
 FROM pg_catalog.pg_auth_members m WHERE m.roleid=r.oid OR m.member=r.oid OR m.grantor=r.oid))::pg_catalog.text) AS metadata_md5
FROM pg_catalog.pg_roles r WHERE r.rolname='nca_push_api'
\gset nca_api_before_
\password nca_push_api
SELECT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r
 WHERE r.oid=:'nca_api_before_oid'::pg_catalog.oid AND r.rolname='nca_push_api'
 AND pg_catalog.md5(pg_catalog.jsonb_build_object('role',pg_catalog.to_jsonb(r)-'rolpassword',
 'memberships',(SELECT pg_catalog.jsonb_agg(pg_catalog.to_jsonb(m) ORDER BY m.roleid,m.member,m.grantor)
 FROM pg_catalog.pg_auth_members m WHERE m.roleid=r.oid OR m.member=r.oid OR m.grantor=r.oid))::pg_catalog.text)=:'nca_api_before_metadata_md5') AS matches
\gset nca_api_after_
\if :nca_api_after_matches
COMMIT;
SELECT 'PUSH_API_CREDENTIAL_CHANGE_COMPLETE' AS marker;
\else
DO $changed$BEGIN RAISE EXCEPTION 'NCA_PUSH_API_CREDENTIAL_METADATA_CHANGED'; END;$changed$;
\endif
