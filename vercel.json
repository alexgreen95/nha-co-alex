{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/personal-push-worker.js": {
      "maxDuration": 60
    },
    "api/content-push-worker.js": {
      "maxDuration": 60
    },
    "api/push-subscriptions.js": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "content-push-pg17-ci": false
    }
  },
  "routes": [
    {
      "src": "/assets/image-[a-f0-9]{12}\\.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
