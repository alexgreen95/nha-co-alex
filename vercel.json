{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/personal-push-worker.js": {
      "maxDuration": 60
    },
    "api/content-push-worker.js": {
      "maxDuration": 60
    },
    "api/content-push-fanout.js": {
      "maxDuration": 60
    },
    "api/push-subscriptions.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/assets/push-settings(?:-base)?\\.js",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
        "Pragma": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/assets/image-[a-f0-9]{12}\\.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
